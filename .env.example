# ==============================================================================
# HealthVoice Environment Variables Example Template
# Copy file này thành .env và điền các API key thực tế của bạn
# ==============================================================================

# Google Gemini LLM API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# FPT.AI / FPT AI Factory API Key
FPT_AI_KEY=your_fpt_ai_key_or_sk_factory_key_here
FPT_AI_API_URL=https://mkp-api.fptcloud.com/v1/audio/speech
FPT_AI_MODEL=FPT.TTS-pro

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=health_voice_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

